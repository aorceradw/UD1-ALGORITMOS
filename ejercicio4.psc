Algoritmo ejercicio4
	Definir num1, num2, multiplicacion, suma, resta, division Como Real
	Escribir 'Escribe el primer número: '
	Leer num1
	Escribir 'Escribe el segundo número: '
	Leer num2
	suma <- num1+num2
	resta <- num1-num2
	division <- num1/num2
	multiplicacion <- num1*num2
	Escribir 'Resultados'
	Escribir '-----------'
	Escribir 'Suma: ', suma
	Escribir 'Resta: ', resta
	Escribir 'Multiplicacion: ', multiplicacion
	Escribir 'Division:  ', division
FinAlgoritmo
