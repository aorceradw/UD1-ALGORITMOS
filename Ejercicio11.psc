Algoritmo Ejercicio11
	Definir num1, num2, distancia Como Real
	Escribir 'Escribe el primer número:'
	Leer num1
	Escribir 'Escribir el segudno número:'
	Leer num2
	Si num1>num2 Entonces
		distancia <- num1-num2
	SiNo
		distancia <- num2-num1
	FinSi
	Escribir 'La distancia entre es ', distancia
FinAlgoritmo
