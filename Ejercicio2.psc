Algoritmo Ejercicio2
	Definir area, perimetro, base, altura Como Real
	Escribir 'Escribe la base: '
	Leer base
	Escribir 'Escribe la altura: '
	Leer altura
	area <- base*altura
	perimetro <- 2*(base*altura)
	Escribir 'El área del rectángulo es:', area
	Escribir 'El perímetro del rectángulo es:', perimetro
FinAlgoritmo
